{
  "manifest_version": 3,
  "name": "Claude Code Web Split View",
  "version": "0.0.1",
  "description": "claude.ai/code に Claude Code desktop 風の分割画面を足す。サイドバーのセッションを Ctrl/⌘+クリックで右のペインに開く",
  "key": "",
  "permissions": [
    "alarms",
    "nativeMessaging",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://github.com/ippoan/claude-code-web-split-view/*",
    "https://objects.githubusercontent.com/*",
    "https://release-assets.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Claude Code Web Split View — クリックで claude.ai/code を開く (新版があれば更新)",
    "default_icon": "icon128.png"
  },
  "icons": {
    "128": "icon128.png"
  },
  "externally_connectable": {
    "matches": [
      "https://claude.ai/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
